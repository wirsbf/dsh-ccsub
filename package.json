{
  "name": "dsh-ccsub",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "Claude Pro/Max subscription route for DSH: browser OAuth (PKCE), quota panel, egress-guarded transport.",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Claude Subscription",
    "description": "Route Claude models through your Claude Pro/Max subscription, with a quota panel and an egress guard."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "@earendil-works/pi-ai": ">=0.87.1 <2",
    "undici": ">=8.10.0 <9"
  }
}

# claude-server — local Docker, egress through claude-gate
#
# Use with:  docker compose --env-file .env.local up -d --build
#
# This machine has no direct route to Anthropic, so every outbound request must
# traverse the proxy. `claude-gate` is the container that provides it; the name
# resolves on the `claude-stealth` network.

UPSTREAM_MODE=proxy
PROXY_URL=http://claude-gate:9077
PROXY_NETWORK=claude-stealth

# Required. Generate once, then paste the same value into DSH's settings card so
# the local plugin can present it:
#   openssl rand -base64 36
CLIENT_BEARER=

# Present a current claude-cli version; Anthropic's own client moves often.
CLAUDE_CLI_VERSION=2.1.303

LOG_LEVEL=info

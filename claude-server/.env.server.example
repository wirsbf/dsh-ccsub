# claude-server — on the server, direct egress
#
# Use with:  docker compose --env-file .env.server up -d --build
#
# The server's own address is the fixed egress IP worth presenting, so no proxy
# is involved. `PROXY_NETWORK` must still name a network that exists on the
# target, or override the compose file to drop the external network entirely.

UPSTREAM_MODE=direct
PROXY_URL=
# Any existing bridge network works; the upstream path does not use it.
PROXY_NETWORK=bridge

# Required. The admin bootstrap token: it unlocks the console, and the server
# refuses to start without it. This is a different value from the local
# deployment's — mint it here with: openssl rand -base64 36
#
# Do NOT hand this to every client. Create a user per client on the console's
# Users page and give them that token; it can relay but cannot open the console.
CLIENT_BEARER=

# Optional. Where the user directory lives; defaults to users.json beside
# GRANT_PATH. Created on first use, never at boot.
# USERS_PATH=/data/users.json

CLAUDE_CLI_VERSION=2.1.303

LOG_LEVEL=info
